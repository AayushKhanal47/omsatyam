# Copy this file to .env before running Docker Compose.

# Public app URL. Use https://your-domain.example in production.
CLIENT_URL=http://localhost
APP_PORT=80

# Local MongoDB credentials used by docker-compose.yml.
# If you use MongoDB Atlas, set MONGO_URI and remove/ignore the local mongo service.
MONGO_ROOT_USERNAME=omsatyam
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
# MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority

# Required. Generate a long random value, for example: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional order notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# Frontend build-time configuration.
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=9779855046299
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Keep true for HTTPS deployments. Set false only when testing over plain HTTP locally.
COOKIE_SECURE=true

# Cloudflare Turnstile bot check on checkout (optional; skipped when unset).
# Create a free widget at https://dash.cloudflare.com -> Turnstile.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
